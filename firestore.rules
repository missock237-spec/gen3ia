rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function projectOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function projectOwnerAfterUpdate() {
      return projectOwner() && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.visibility in ['private', 'public'];
    }
    function isTeamMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }
    function getTeamRole(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role;
    }
    function isTeamOwner(teamId) { return isTeamMember(teamId) && getTeamRole(teamId) == 'owner'; }
    function isTeamAdmin(teamId) { return isTeamMember(teamId) && getTeamRole(teamId) in ['owner', 'admin']; }
    function canEditTeam(teamId) { return isTeamMember(teamId) && getTeamRole(teamId) in ['owner', 'admin', 'editor']; }

    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;
    }
    match /artifacts/{artifactId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.visibility == 'public');
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.visibility in ['private', 'public'];
      allow update: if projectOwnerAfterUpdate();
      allow delete: if projectOwner();
    }
    match /projects/{projectId}/members/{memberId} {
      allow read: if signedIn() && (memberId == request.auth.uid || get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid);
      allow create, update, delete: if signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }
    match /skills/{skillId} {
      allow read: if signedIn() && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /agents/{agentId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /executions/{executionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /researchJobs/{jobId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /documents/{documentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /deployments/{deploymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }
    match /usage/{usageId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /userWallets/{userId} { allow read: if isOwner(userId); allow write: if false; }
    match /walletLedger/{entryId} { allow read: if isAdmin(); allow write: if false; }
    match /executionIdempotency/{entryId} { allow read, write: if false; }
    match /securityAuditEvents/{eventId} { allow read: if isAdmin(); allow write: if false; }
    match /toolAuditLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
    match /emergencyStops/{stopId} { allow read: if isOwner(stopId) || isAdmin(); allow write: if false; }
    match /adsSpendBudgets/{budgetId} { allow read: if isAdmin(); allow write: if false; }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isTeamAdmin(teamId);
      allow delete: if isTeamOwner(teamId);
      match /members/{memberId} {
        allow read: if isTeamMember(teamId);
        allow create: if signedIn() && ((memberId == request.auth.uid && request.resource.data.role == 'owner') || isTeamAdmin(teamId));
        allow update: if isTeamAdmin(teamId) || request.auth.uid == memberId;
        allow delete: if isTeamAdmin(teamId) || request.auth.uid == memberId;
      }
    }
    match /invitations/{invitationId} {
      allow read: if signedIn();
      allow create: if signedIn() && isTeamAdmin(request.resource.data.teamId);
      allow update: if signedIn() && (isTeamAdmin(resource.data.teamId) || (request.auth.token.email == resource.data.invitedEmail && request.resource.data.status in ['accepted', 'declined']));
      allow delete: if isTeamAdmin(resource.data.teamId);
    }
    match /userTeams/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Extension platform: all mutations are performed by trusted API/Admin SDK.
    match /extensions/{extensionId} { allow read: if signedIn(); allow write: if false; }
    match /extensionVersions/{versionId} { allow read: if signedIn(); allow write: if false; }
    match /extensionInstallations/{installationId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /extensionEntitlements/{entitlementId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /extensionReviews/{reviewId} { allow read: if signedIn(); allow write: if false; }
    match /extensionReports/{reportId} { allow read, write: if false; }
    match /extensionPurchases/{purchaseId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /extensionLicenses/{licenseId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /extensionExecutions/{executionId} { allow read, write: if false; }
    match /extensionUsageCounters/{counterId} { allow read, write: if false; }
    match /extensionSecrets/{secretId} { allow read, write: if false; }
    match /developers/{developerId} { allow read: if signedIn() && developerId == request.auth.uid; allow write: if false; }
    match /developerRevenue/{entryId} { allow read: if signedIn() && resource.data.developerId == request.auth.uid; allow write: if false; }
    match /developerApiKeys/{keyHash} { allow read, write: if false; }
    match /system/{document=**} { allow read, write: if false; }
    // Collections serveur uniquement (Admin SDK) : acces client explicitement interdit.
    match /liveAgentSessions/{sessionId} { allow read, write: if false; }
    match /agentCameraRequests/{requestId} { allow read, write: if false; }
    match /agentWorkspaceTasks/{taskId} { allow read, write: if false; }
    match /chatConversations/{conversationId} { allow read, write: if false; }
    match /chatMessages/{messageId} { allow read, write: if false; }
    match /skillVersions/{versionId} { allow read, write: if false; }
    match /skillEvaluations/{evaluationId} { allow read, write: if false; }
    match /chariowPulseDeliveries/{deliveryId} { allow read, write: if false; }
    match /events/{eventId} { allow read, write: if false; }
  }
}
