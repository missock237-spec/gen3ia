# Générer un secret long et aléatoire. Ne jamais committer ce fichier.
QUEUE_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Endpoints réels de génération gen3ia (backend ou fournisseurs GPU).
# Valeur vide = worker distant volontairement désactivé (erreur permanente explicite).
GEN3IA_IMAGE_ENDPOINT=
GEN3IA_AUDIO_ENDPOINT=
GEN3IA_VIDEO_ENDPOINT=
PROVIDER_BEARER_TOKEN=

# Politique qualité. Les générateurs distants doivent renvoyer quality.score (0..1)
# ou quality_passed=true ; sinon la tâche part en review_required (jamais « validée »).
MIN_QUALITY_SCORE=0.75
MAX_RETRIES=5
RETRY_BASE_SECONDS=2
PROVIDER_TIMEOUT_SECONDS=1800
# Doit rester supérieur à la plus longue tâche distante normale (reprise par re-claim).
CLAIM_IDLE_MS=21600000
DATA_DIR=/app/data

# Voie rapide : priorité <= seuil publiée dans gen3ia:queue:<modalité>:fast
# et traitée en premier par le worker (même valeur côté api et workers).
FAST_LANE_MAX_PRIORITY=3

# Expiration (secondes) des états terminaux des jobs — évite la croissance
# illimitée de Redis sur un petit VPS. 0 = ne jamais expirer.
JOB_TTL_SECONDS=604800
