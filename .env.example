# =========================================================
# EXTENSION PLATFORM & MARKETPLACE
# =========================================================
# Limites d'execution du runtime d'extensions (par utilisateur + extension)
EXTENSION_RATE_LIMIT_PER_MIN=30
EXTENSION_DAILY_EXECUTION_LIMIT=200
# Commission plateforme sur les ventes d'extensions (points de base : 2000 = 20%)
EXTENSION_PLATFORM_FEE_BPS=2000
# Produit Chariow unique pour l'achat direct d'extensions payantes
# (optionnel : sans cette variable, l'achat passe par le wallet Gen3ia).
# Les ventes sont identifiees par custom_metadata.gen3ia_product=extension_purchase
CHARIOW_EXT_PRODUCT_ID=

# =========================================================
# AGENT SCHEDULER
# =========================================================
# Secret server-only used by the Vercel cron endpoint.
# Generate a long random value and set the same value in Vercel.
CRON_SECRET=

# =========================================================
# MESSAGERIE AGENT (WhatsApp / Telegram / Slack)
# =========================================================
# Compte WhatsApp Business Cloud API (Meta) : token system-user + ID du
# numero emetteur. Les destinataires configurés par l'utilisateur depuis
# /integrations recoivent les notifications et liens d'approbation.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bot Telegram (token fourni par @BotFather).
TELEGRAM_BOT_TOKEN=
# Bot Slack (scope chat:write). SLACK_BOT_TOKEN=xoxb-...
SLACK_BOT_TOKEN=
# Couts unitaires (EUR) - utilise par lib/billing/media-meter.ts
COST_SLACK_MESSAGE_EUR=0.0005

# =========================================================
# EMAIL AGENTIQUE (Resend)
# =========================================================
# Cle API Resend + adresse d'expedition sur un domaine verifie.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
COST_EMAIL_EUR=0.001

# =========================================================
# WEBHOOKS SORTANTS (n8n / Make / Zapier)
# =========================================================
# Aucune variable requise : les endpoints sont declares par utilisateur
# depuis /integrations, chaque livraison est signee HMAC-SHA256.
COST_WEBHOOK_EUR=0.0005

# =========================================================
# APPROBATION DISTANTE (liens WhatsApp/Telegram)
# =========================================================
# Secret HMAC dedie aux liens d'approbation distantes. Si vide, un secret
# derive des identifiants Firebase serveur est utilise (repli deterministe).
REMOTE_APPROVAL_SECRET=

# =========================================================
# OBSERVABILITÉ SENTRY (Task 40, Rec 4)
# =========================================================
# DSN public par conception (désigne le projet d'ingestion, n'authentifie
# rien). Serveur ET navigateur : les deux variables doivent être identiques.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Secret de BUILD (Vercel) : upload des source maps. Absent = build vert,
# stacks minifiés (dégradation assumée).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=gen3ia
SENTRY_PROJECT=javascript-nextjs
SENTRY_ENVIRONMENT=production
# Diverses : SENTRY_RELEASE est auto-dérivé de VERCEL_GIT_COMMIT_SHA.
# Tunnel anti-bloqueurs : /monitoring (route dédiée, liste blanche d'hôtes).

# =========================================================
# GOOGLE ADSENSE (Task 40, monétisation vitrine)
# =========================================================
# Identifiant éditeur PUBLIC (ca-pub-…). Slots sur pages de contenu public
# uniquement (composant AdSenseAd). ads.txt servi depuis /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# =========================================================
# MARKETPLACE — SANDBOX D'ÉVALUATION D'EXTENSIONS (Task 132)
# =========================================================
# Durée par défaut (en heures) d'un essai d'évaluation d'extension
# démarré depuis la marketplace (plafonds d'usage par essai :
# 50 appels d'outils et 20 exécutions — cf. lib/marketplace/sandbox.ts).
EXTENSION_TRIAL_HOURS=48
