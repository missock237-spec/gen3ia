FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================================================
# SESSION AUTH — COMPTES NATIFS R2 (Task 151) + cookie signé
# =========================================================
# Secret HMAC du cookie de session `gen3ia_session` (HttpOnly, 30 jours).
# REQUIS en production dès que l'authentification native R2 est active :
# sans lui, le secret serait dérivé des variables Firebase (absentes sur un
# déploiement sans service account) — un secret explicite de 64 caractères
# hexadécimaux garantit la signature des sessions.
#   Génération : openssl rand -hex 32
# La connexion/inscription par e-mail + mot de passe fonctionne SANS Firebase
# (comptes stockés dans R2 : POST /api/auth/r2/signup, /api/auth/r2/login).
SESSION_SECRET=

# =========================================================
# FORTERESSE — sécurité & confidentialité absolue (Task mesh/timebox)
# =========================================================
# Secret HMAC des tickets d'admission du MESH PRIVÉ (essaim privé du plan
# Entreprise, lib/ondes/mesh-prive.ts). Tickets signés TTL 10 min : sans
# ticket signé, aucune salle `mesh-*` ne peut être rejointe ni lue.
#   Génération : openssl rand -hex 32
MESH_SIGNING_KEY=

# Clé maîtresse de la FORTERESSE (lib/security/forteresse.ts) : chiffre-
# ment AES-256-GCM des artefacts de modèles au repos + scellement HMAC +
# chaînage du journal d'audit (lib/security/journal-chaine.ts). Sans elle,
# la clé est dérivée de SESSION_SECRET / variables Firebase (fonctionne,
# mais un secret DÉDIÉ est recommandé : sa rotation n'invalide pas les
# sessions).
#   Génération : openssl rand -hex 32
MODELS_SEALING_KEY=

