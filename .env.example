# Qualité des réponses visibles (conversation, chat d'agent, livrables) :
# premium = route vers le MEILLEUR fournisseur configuré (défaut, qualité
# comparable à ChatGPT) ; free = comportement historique préférence modèles
# gratuits (coût minimal). Les tâches internes restent toujours optimisées coût.
GEN3IA_RESPONSE_QUALITY=premium

# Hugging Face (requis pour la recherche semantique de competences et les embeddings memoire)
HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =========================================================
# WEB SEARCH PROVIDERS (tavily | serper | serpapi)
# =========================================================
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=

# =========================================================
# R2 OBJECT STORAGE (Cloudflare)
# =========================================================
# R2 utilise ses propres identifiants (R2_*). Les variables CLOUDFLARE_*
# servent à l'intégration Cloudflare des agents (zones + DNS via API v4).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# =========================================================
# SANDBOX EXECUTION SERVICE (optionnel — cf. docs/terminal-execution.md)
# =========================================================
# Sans ces variables, le terminal intégré (agents + utilisateurs) et
# code.execute utilisent l'EXÉCUTION RÉELLE SERVERLESS en-processus :
# microVM Vercel, env nettoyé (PATH + HOME=/tmp + LANG), cwd dans un
# workspace /tmp éphémère par utilisateur (réutilisé à chaud, recréé à
# froid — AUCUN état garanti entre instances), ulimit mémoire, timeout dur,
# sortie plafonnée, deny-list durcie (lib/sandbox/policy.ts).
#
# Pour des sessions PERSISTANTES et une isolation Docker complète (réseau
# none, read-only, pids/memory limités), déployez le service sandbox/ :
#   1. cd sandbox && npm install && npm run build
#   2. docker build -t gen3ia-sandbox-node -f docker/node/Dockerfile docker/node
#      docker build -t gen3ia-sandbox-python -f docker/python/Dockerfile docker/python
#   3. SANDBOX_SHARED_SECRET=<32+ caractères aléatoires> npm start   # service HTTP + HMAC
#   4. Renseigner ci-dessous l'URL publique du service.
# La chaîne de décision reste : Docker (si configuré) > serverless > simulation.
SANDBOX_URL=
SANDBOX_SHARED_SECRET=

# =========================================================
# LIVE GATEWAY (WebSocket)
# =========================================================
LIVE_GATEWAY_PORT=8787

# =========================================================
# GITHUB / VERCEL / RENDER INTEGRATIONS
# =========================================================
GITHUB_TOKEN=
VERCEL_TOKEN=
RENDER_API_KEY=

# =========================================================
# COMPOSIO / EXTERNAL AGENT CONNECTIONS
# =========================================================
COMPOSIO_API_KEY=
COMPOSIO_TOOLKIT_VERSION=

# =========================================================
# ELEVENLABS VOICE (TTS multilingue, FR supporte)
# =========================================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# =========================================================
# BLAND AI — VOICE CALLS (appels vocaux des agents IA)
# =========================================================
# Clé API organisation Bland (server-only, jamais NEXT_PUBLIC_*).
# Dashboard : https://app.bland.ai/dashboard/settings
BLAND_API_KEY=
# Secret de signature des webhooks Bland (X-Webhook-Signature = HMAC-SHA256 hex
# du corps brut). Créé dans le dashboard Bland : Settings > Keys > Replace Secret.
# Fortement recommandé en production pour rejeter les webhooks falsifiés.
BLAND_WEBHOOK_SECRET=
# URL publique de base que Bland doit appeler (défaut : NEXT_PUBLIC_APP_URL).
BLAND_WEBHOOK_BASE_URL=
# Quota journalier d'appels vocaux par utilisateur + solde wallet minimal
# (centimes d'euro) exigé pour DÉMARRER un appel.
GEN3IA_MAX_DAILY_VOICE_CALLS=20
GEN3IA_VOICE_CALL_MIN_BALANCE_MINOR=100

# URL publique HTTPS de l'application (base des webhooks entrants).
NEXT_PUBLIC_APP_URL=

# =========================================================
# JULES (agent de code asynchrone de Google — jules.google)
# Task 121 : toute demande de code dans le chat IA est routée
# automatiquement vers une session Jules (POST /sessions v1alpha,
# authentification X-Goog-Api-Key). Sans cette clé, l'agent répond
# honnêtement que l'intégration est en préparation et traite la demande
# via ses outils internes (aucun refus de cadre).
# =========================================================
JULES_API_KEY=
# Base de l'API Jules (défaut : https://jules.googleapis.com/v1alpha).
# Le suivi des sessions est automatique : ticket dans la file de ticks R2
# + receiver /api/cron/jules-followup (bearer CRON_SECRET) qui livre le
# résultat (patch/PR) dans la conversation d'origine.
# JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha

# =========================================================
# NOTION (recherche + création de pages dans l'espace autorisé)
# =========================================================
NOTION_API_TOKEN=
# NOTION_API_VERSION=2022-06-28

