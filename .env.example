# =========================================================
# GEN3IA USER WALLET / CHARIOW
# =========================================================
GEN3IA_WALLET_CURRENCY=EUR
# MODE LIBRE (migration R2 totale) : false = aucun débit de crédit, aucune
# réservation, aucun blocage d'exécution (agents, missions, outils, vidéos,
# médias). Les recharges Chariow et gains marketplace restent crédités.
# Absent ou true = facturation active (comportement historique).
GEN3IA_BILLING_ENABLED=true
CHARIOW_TOPUP_STORE_URL=
CHARIOW_TOPUP_PRODUCT_ID=
CHARIOW_PULSE_SECRET=
CHARIOW_API_KEY=

# =========================================================
# FIREBASE (CLIENT SDK - NEXT_PUBLIC_*)
# =========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =========================================================
# FIREBASE ADMIN SDK (SERVER)
# =========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================================================
# SESSION AUTH — COMPTES NATIFS R2 (Task 151) + cookie signé
# =========================================================
# Secret HMAC du cookie de session `gen3ia_session` (HttpOnly, 30 jours).
# REQUIS en production dès que l'authentification native R2 est active :
# sans lui, le secret serait dérivé des variables Firebase (absentes sur un
# déploiement sans service account) — un secret explicite de 64 caractères
# hexadécimaux garantit la signature des sessions.
#   Génération : openssl rand -hex 32
# La connexion/inscription par e-mail + mot de passe fonctionne SANS Firebase
# (comptes stockés dans R2 : POST /api/auth/r2/signup, /api/auth/r2/login).
SESSION_SECRET=

# =========================================================
# MOTEUR IA — SYSTÈME NEURONAL GEN3 (unique moteur)
# =========================================================
# Les IA externes (OpenAI, Anthropic, Groq, OpenRouter, GLM, Agnes, HF
# Inference, ElevenLabs, Bland, Jules, 21st.dev) ont été SUPPRIMÉES du
# projet sur demande explicite de l'utilisateur. Toutes les capacités IA
# passent par le moteur neuronal interne (lib/neural/ — SNN à spikes,
# plasticité hebbienne, corps sémantique, génération média locale).
# Aucune clé d'IA externe n'est nécessaire ni lue.

# HF_TOKEN reste utilisé UNIQUEMENT par l'import de DATASETS Hugging Face
# du AI Training Studio (téléchargement de données — pas d'inférence IA).
# HF_TOKEN=

# =========================================================
# WEB SEARCH PROVIDERS (tavily | serper | serpapi)
# =========================================================
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=

# =========================================================
# R2 OBJECT STORAGE (Cloudflare)
# =========================================================
# R2 utilise ses propres identifiants (R2_*). Les variables CLOUDFLARE_*
# servent à l'intégration Cloudflare des agents (zones + DNS via API v4).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# =========================================================
# SANDBOX EXECUTION SERVICE (optionnel — cf. docs/terminal-execution.md)
# =========================================================
# Sans ces variables, le terminal intégré (agents + utilisateurs) et
# code.execute utilisent l'EXÉCUTION RÉELLE SERVERLESS en-processus :
# microVM Vercel, env nettoyé (PATH + HOME=/tmp + LANG), cwd dans un
# workspace /tmp éphémère par utilisateur (réutilisé à chaud, recréé à
# froid — AUCUN état garanti entre instances), ulimit mémoire, timeout dur,
# sortie plafonnée, deny-list durcie (lib/sandbox/policy.ts).
#
# Pour des sessions PERSISTANTES et une isolation Docker complète (réseau
# none, read-only, pids/memory limités), déployez le service sandbox/ :
#   1. cd sandbox && npm install && npm run build
#   2. docker build -t gen3ia-sandbox-node -f docker/node/Dockerfile docker/node
#      docker build -t gen3ia-sandbox-python -f docker/python/Dockerfile docker/python
#   3. SANDBOX_SHARED_SECRET=<32+ caractères aléatoires> npm start   # service HTTP + HMAC
#   4. Renseigner ci-dessous l'URL publique du service.
# La chaîne de décision reste : Docker (si configuré) > serverless > simulation.
SANDBOX_URL=
SANDBOX_SHARED_SECRET=

# =========================================================
# LIVE GATEWAY (WebSocket)
# =========================================================
LIVE_GATEWAY_PORT=8787

# =========================================================
# GITHUB / VERCEL / RENDER INTEGRATIONS
# =========================================================
GITHUB_TOKEN=
VERCEL_TOKEN=
RENDER_API_KEY=

# =========================================================
# COMPOSIO / EXTERNAL AGENT CONNECTIONS
# =========================================================
COMPOSIO_API_KEY=
COMPOSIO_TOOLKIT_VERSION=

# URL publique HTTPS# URL publique HTTPS de l'application (base des webhooks entrants).
NEXT_PUBLIC_APP_URL=

# =========================================================
# NOTION# =========================================================
# NOTION (recherche + création de pages dans l'espace autorisé)
# =========================================================
NOTION_API_TOKEN=
# NOTION_API_VERSION=2022-06-28

# =========================================================
# ADS PROVIDERS / OAUTH (legacy direct provider mode)
# =========================================================
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
TIKTOK_ADS_CLIENT_KEY=
TIKTOK_ADS_CLIENT_SECRET=
TIKTOK_ADS_AUTH_URL=https://business-api.tiktok.com/portal/auth
TIKTOK_ADS_TOKEN_URL=https://business-api.tiktok.com/open_api/v1.3/oauth2/access_token/
TIKTOK_ADS_PUBLISH_URL=https://business-api.tiktok.com/open_api/v1.3/campaign/create/
GEN3IA_ADS_TOKEN_ENCRYPTION_KEY=

# =========================================================
# EXTERNAL ADS SPEND SAFETY
# =========================================================
# Hard server-side maximum total Ads budget that Gen3ia may reserve
# per user + provider + connected account + UTC day.
# Minor EUR units: 2000 = 20.00 EUR.
GEN3IA_MAX_DAILY_AD_SPEND_EUR_MINOR=2000

# =========================================================
# PERMANENT STORAGE
# =========================================================
GEN3IA_MAX_PERMANENT_FILE_BYTES=104857600

# =========================================================
# GEN3IA BILLING - LLM / MODEL PRICES
# =========================================================
GEN3IA_MODEL_PRICING_JSON=[]

# =========================================================
# INFRASTRUCTURE / TOOLS
# =========================================================
GEN3IA_EXECUTION_OVERHEAD_EUR=0.0005
GEN3IA_TOOL_CALL_OVERHEAD_EUR=0.0002
GEN3IA_COMPUTE_EUR_PER_UNIT=0.001
GEN3IA_STORAGE_EUR_PER_GB=0.02
GEN3IA_NETWORK_EUR_PER_GB=0.08
COST_WEB_SEARCH_EUR=0.002
COST_BROWSER_ACTION_EUR=0.004
COST_COMPOSIO_ACTION_EUR=0.003
COST_SANDBOX_EUR_PER_MINUTE=0.01
COST_DATABASE_OPERATION_EUR=0.0002
COST_DOCUMENT_OPERATION_EUR=0.001
COST_OTHER_TOOL_EUR=0.0005
COST_ADS_PUBLISH_EUR=0.02

# =========================================================
# FILES / ZIP / ARTIFACTS
# =========================================================
COST_FILE_READ_EUR=0.0001
COST_FILE_WRITE_EUR=0.0005
COST_FILE_DELETE_EUR=0.0005
COST_ZIP_ANALYZE_EUR=0.001
COST_ZIP_CREATE_EUR=0.002
COST_ZIP_EXTRACT_EUR=0.002
COST_ARTIFACT_CREATE_EUR=0.001
COST_ARTIFACT_DOWNLOAD_EUR=0.0002

# =========================================================
# MÉDIAS NEURONAUX LOCAUX (visuel SVG, audio WAV, vidéo SVG animé)
# =========================================================
# Génération 100 % locale par le moteur neuronal Gen3 — aucun coût
# fournisseur, aucune clé. Les visuels scènes de la production vidéo
# sont générés par le même moteur (rastérisés en PNG via sharp).

# =========================================================
# WHATSAPP / TELEGRAM / EMAIL / SOCIAL / WEBHOOKS
# =========================================================
COST_WHATSAPP_MESSAGE_EUR=0.01
COST_WHATSAPP_CALL_EUR_PER_MINUTE=0.12
COST_TELEGRAM_MESSAGE_EUR=0.001
COST_EMAIL_EUR=0.001
COST_SOCIAL_POST_EUR=0.003
COST_SOCIAL_VIDEO_PUBLISH_EUR=0.01
COST_WEBHOOK_EUR=0.0005

# =========================================================
# RESOURCE METERING
# =========================================================
COST_COMPUTE_EUR_PER_MINUTE=0.01
COST_GPU_EUR_PER_MINUTE=0.05
COST_STORAGE_READ_GB_EUR=0.01
COST_STORAGE_WRITE_GB_EUR=0.02
COST_NETWORK_EGRESS_GB_EUR=0.08

# =========================================================
# BUSINESS RULES
# =========================================================
GEN3IA_PLATFORM_MARGIN_RATE=0.35
GEN3IA_RESERVE_MULTIPLIER=2
GEN3IA_MIN_EXECUTION_CHARGE_EUR=0.001
# Task 153 (paiement par exécution) — conversion EUR → XAF appliquée à TOUS
# les débits du portefeuille : les coûts externes sont exprimés en EUR et le
# wallet est en FCFA minor (100 minor = 1 XAF). Parité fixe CFA par défaut.
GEN3IA_EUR_TO_XAF=655.957
# Plafond de réservation par exécution derrière le portillon de facturation
# (anti-blocage d'un solde entier sur une interaction multi-appels).
GEN3IA_MAX_EXECUTION_RESERVE_EUR=10

# =========================================================
# EXTENSION PLATFORM & MARKETPLACE
# =========================================================
# Limites d'execution du runtime d'extensions (par utilisateur + extension)
EXTENSION_RATE_LIMIT_PER_MIN=30
EXTENSION_DAILY_EXECUTION_LIMIT=200
# Commission plateforme sur les ventes d'extensions (points de base : 2000 = 20%)
EXTENSION_PLATFORM_FEE_BPS=2000
# Produit Chariow unique pour l'achat direct d'extensions payantes
# (optionnel : sans cette variable, l'achat passe par le wallet Gen3ia).
# Les ventes sont identifiees par custom_metadata.gen3ia_product=extension_purchase
CHARIOW_EXT_PRODUCT_ID=

# =========================================================
# AGENT SCHEDULER
# =========================================================
# Secret server-only used by the Vercel cron endpoint.
# Generate a long random value and set the same value in Vercel.
CRON_SECRET=

# =========================================================
# MESSAGERIE AGENT (WhatsApp / Telegram / Slack)
# =========================================================
# Compte WhatsApp Business Cloud API (Meta) : token system-user + ID du
# numero emetteur. Les destinataires configurés par l'utilisateur depuis
# /integrations recoivent les notifications et liens d'approbation.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bot Telegram (token fourni par @BotFather).
TELEGRAM_BOT_TOKEN=
# Bot Slack (scope chat:write). SLACK_BOT_TOKEN=xoxb-...
SLACK_BOT_TOKEN=
# Couts unitaires (EUR) - utilise par lib/billing/media-meter.ts
COST_SLACK_MESSAGE_EUR=0.0005

# =========================================================
# EMAIL AGENTIQUE (Resend)
# =========================================================
# Cle API Resend + adresse d'expedition sur un domaine verifie.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
COST_EMAIL_EUR=0.001

# =========================================================
# WEBHOOKS SORTANTS (n8n / Make / Zapier)
# =========================================================
# Aucune variable requise : les endpoints sont declares par utilisateur
# depuis /integrations, chaque livraison est signee HMAC-SHA256.
COST_WEBHOOK_EUR=0.0005

# =========================================================
# APPROBATION DISTANTE (liens WhatsApp/Telegram)
# =========================================================
# Secret HMAC dedie aux liens d'approbation distantes. Si vide, un secret
# derive des identifiants Firebase serveur est utilise (repli deterministe).
REMOTE_APPROVAL_SECRET=

# =========================================================
# OBSERVABILITÉ SENTRY (Task 40, Rec 4)
# =========================================================
# DSN public par conception (désigne le projet d'ingestion, n'authentifie
# rien). Serveur ET navigateur : les deux variables doivent être identiques.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Secret de BUILD (Vercel) : upload des source maps. Absent = build vert,
# stacks minifiés (dégradation assumée).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=gen3ia
SENTRY_PROJECT=javascript-nextjs
SENTRY_ENVIRONMENT=production
# Diverses : SENTRY_RELEASE est auto-dérivé de VERCEL_GIT_COMMIT_SHA.
# Tunnel anti-bloqueurs : /monitoring (route dédiée, liste blanche d'hôtes).

# =========================================================
# GOOGLE ADSENSE (Task 40, monétisation vitrine)
# =========================================================
# Identifiant éditeur PUBLIC (ca-pub-…). Slots sur pages de contenu public
# uniquement (composant AdSenseAd). ads.txt servi depuis /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# =========================================================
# MARKETPLACE — SANDBOX D'ÉVALUATION D'EXTENSIONS (Task 132)
# =========================================================
# Durée par défaut (en heures) d'un essai d'évaluation d'extension
# démarré depuis la marketplace (plafonds d'usage par essai :
# 50 appels d'outils et 20 exécutions — cf. lib/marketplace/sandbox.ts).
EXTENSION_TRIAL_HOURS=48

# =========================================================
# PRODUCTION VIDÉO — pipeline interne
# =========================================================
# Clips vidéo IA externes (Agnes Video) SUPPRIMÉS du projet : la
# production vidéo utilise l'animation image Ken Burns interne sur les
# visuels neuraux + les narrations enregistrées par l'utilisateur.
# Plafond de visuels générés par projet (spéc §28).
VIDEO_MAX_GENERATED_SCENE_VIDEOS=300

# =========================================================
# AI TRAINING STUDIO — quotas et orchestration GPU
# =========================================================
# Tous facultatifs : sans configuration, le studio fonctionne en mode
# gratuit maîtrisé et les tâches restent honnêtement en file d'attente.
# Nombre maximal de projets d'entraînement ACTIFS par utilisateur.
TRAINING_MAX_PROJECTS=10
# Tâches d'entraînement simultanées (queued + running) par utilisateur.
TRAINING_MAX_CONCURRENT_JOBS=1
# Taille maximale d'un fichier téléversé (modèle ou dataset), en Mo.
TRAINING_MAX_UPLOAD_MB=200
# Nombre maximal de datasets / modèles importés par projet.
TRAINING_MAX_DATASETS=50
TRAINING_MAX_MODELS=20
# Worker GPU distant (service Python FastAPI + PyTorch/PEFT) :
# URL de base (ex. http://gpu-host:8000) — absent = aucun GPU configuré.
TRAINING_WORKER_URL=
# Jeton d'authentification du worker GPU (Bearer).
TRAINING_WORKER_TOKEN=
# Délai d'expiration des liens d'export signés (minutes).
TRAINING_EXPORT_TTL_MINUTES=30
# Stockage TOTAL du Training Studio par utilisateur (Mo) — v1.1.
TRAINING_MAX_STORAGE_MB=2048
# Minutes d'entraînement réelles par mois civil et par utilisateur — v1.1.
TRAINING_MAX_MINUTES_PER_MONTH=60
# Taille totale maximale d'un import hub Hugging Face / Kaggle (Mo) — v1.1.
TRAINING_MAX_HUB_IMPORT_MB=500
# SIMULATION — tests/dev UNIQUEMENT. Ne JAMAIS activer en production :
# un fournisseur fictif fait tourner des cycles simulés étiquetés.
TRAINING_ALLOW_MOCK=false
# Durée d'une étape simulée pour le mock (ms) — utilisé par les tests.
TRAINING_MOCK_STEP_MS=1500

# =========================================================
# HUBS DE DATASETS (AI Training Studio v1.1)
# =========================================================
# Kaggle — jeton d'API (dashboard Kaggle > Settings > API > Create New Token,
# format KGAT_…). Authentification Bearer, usage serveur UNIQUEMENT.
# Sans ce jeton : l'onglet Kaggle signale honnêtement que l'intégration
# n'est pas configurée (aucune erreur silencieuse).
KAGGLE_API_TOKEN=
# Hugging Face — le jeton optionnel HF_TOKEN (section AI PROVIDERS ci-dessus)
# est réutilisé tel quel par le connecteur : recherche et inspection
# fonctionnent sans jeton, les quotas d'appel sont simplement plus stricts.
