# =========================================================
# GEN3IA USER WALLET / CHARIOW
# =========================================================
# Devise du portefeuille. DOIT correspondre à la devise de facturation des
# produits de recharge Chariow (XAF/FCFA boutique Gen3ia) : le webhook refuse
# toute recharge dans une autre devise que celle du wallet.
GEN3IA_WALLET_CURRENCY=XAF
# MODE LIBRE (migration R2 totale) : false = aucun débit de crédit, aucune
# réservation, aucun blocage d'exécution (agents, missions, outils, vidéos,
# médias). Les recharges Chariow et gains marketplace restent crédités.
# Absent ou true = facturation active (comportement historique).
GEN3IA_BILLING_ENABLED=true
# PASSERELLE DE PAIEMENT UNIQUE (décision client 2026-10-23) : Chariow est la
# seule passerelle d'encaissement (abonnements, recharge wallet, extensions).
# Valeur par défaut et SEULE supportée : chariow. Toute autre valeur
# court-circuite les encaissements (501) via lib/billing/payment-provider.ts.
PAYMENT_PROVIDER=chariow
# Produit Chariow de RECHARGE DU WALLET API (widget « Recharge Wallet API »
# rendu sur /billing + reconnaissance webhook). Défaut boutique :
# prd_llfosdp1 — doit être facturé en XAF côté Chariow. Laisser la valeur
# par défaut ; surcharger uniquement pour pointer un produit de remplacement
# (le produit par défaut n'est alors plus reconnu par le webhook).
CHARIOW_TOPUP_PRODUCT_ID=prd_llfosdp1
# Repli boutique : page Chariow ouverte en lien secondaire sur /billing quand
# le checkout API n'est pas utilisable (ex. https://xdaagetk.mychariow.shop).
CHARIOW_TOPUP_STORE_URL=
# Secret HMAC du webhook Pulse (successful.sale) : seule voie de crédit
# automatique du wallet après paiement (signature x-chariow-signature).
CHARIOW_PULSE_SECRET=
CHARIOW_API_KEY=
# =========================================================
# GEN3IA OFFRES (GRILLE TARIFAIRE CHARIOW) — /billing
# =========================================================
# Devise de facturation des offres et du wallet (devise de la boutique Chariow).
# Grille : Gratuit 0 FCFA · Pro 9 750 FCFA (≈15 €)/mois · Entreprise 328 000 FCFA
# (≈500 €)/mois · Modèle Sur-Mesure 3 280 000 FCFA (≈5 000 €)/modèle.
# Les produits « license » correspondants sont créés dans le dashboard Chariow
# (l'API publique est en lecture seule sur /products) puis leurs IDs publics
# (prd_…) sont reportés ici. Le produit Pro déjà créé dans la boutique est
# utilisé par défaut si la variable reste vide.
CHARIOW_PLAN_PRO_PRODUCT_ID=
CHARIOW_PLAN_ENTREPRISE_PRODUCT_ID=
CHARIOW_PLAN_SUR_MESURE_PRODUCT_ID=
# Taux EUR→XAF de la grille commerciale (parité fixe du franc CFA).
CHARIOW_EUR_XAF_RATE=655.957

# =========================================================
# FIREBASE (CLIENT SDK - NEXT_PUBLIC_*)
