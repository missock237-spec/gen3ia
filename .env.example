# =========================================================
# HUBS DE DATASETS (AI Training Studio v1.1)
# =========================================================
# Kaggle — jeton d'API (dashboard Kaggle > Settings > API > Create New Token,
# format KGAT_…). Authentification Bearer, usage serveur UNIQUEMENT.
# Sans ce jeton : l'onglet Kaggle signale honnêtement que l'intégration
# n'est pas configurée (aucune erreur silencieuse).
KAGGLE_API_TOKEN=
# Hugging Face — le jeton optionnel HF_TOKEN (section AI PROVIDERS ci-dessus)
# est réutilisé tel quel par le connecteur : recherche et inspection
# fonctionnent sans jeton, les quotas d'appel sont simplement plus stricts.

# =========================================================
# AUTO-APPRENTISSAGE — CYCLE DE VIE : ABSORPTION (2 h) → AUTONOMIE
# =========================================================
# Au boot du serveur (instrumentation.ts), Gen3ia se connecte à ses hubs de
# datasets (HF + Kaggle si KAGGLE_API_TOKEN est défini) et s'entraîne
# AUTOMATIQUEMENT. DEUX RÉGIMES DE VIE (état v3, persisté) :
#
#  RÉGIME MAÎTRISE (défaut — entraînement autonome à grande échelle) :
#    les hubs restent ouverts CYCLE APRÈS CYCLE, domaine après domaine,
#    JUSQU'À maîtrise complète du catalogue (12 domaines : conversation,
#    question-réponse, instructions, connaissances, mathématiques, sciences,
#    culture-histoire, langues, intentions, émotions, sujets, sécurité).
#    Chaque domaine est déclaré maîtrisé UNIQUEMENT sur des mesures réelles :
#    précision de validation ≥ seuil sur des données tenues à l'écart,
#    2 évaluations consécutives valides. La boucle ne s'arrête qu'à maîtrise
#    complète — jamais sur un échec (backoff à la place).
#
#  RÉGIME FENÊTRE (historique, AUTO_APPRENTISSAGE_MAITRISE=0) : fenêtre
#    BORNÉE (défaut 2 h depuis le PREMIER lancement) puis clôture
#    DÉFINITIVE — les hubs ne sont plus jamais interrogés.
#
# AUTO_APPRENTISSAGE=0 désactive la boucle automatique (l'API POST manuelle
# reste disponible tant que les hubs sont accessibles).
AUTO_APPRENTISSAGE=1
# Régime de vie : 1 = maîtrise (continu, défaut) · 0 = fenêtre (historique).
AUTO_APPRENTISSAGE_MAITRISE=1
# Intervalle des cycles en régime maîtrise (minutes, 5 → 240 ; défaut 15).
# Backoff automatique ×2 par tranche de 3 cycles sans progrès (plafonné ×4).
AUTO_APPRENTISSAGE_MAITRISE_INTERVALLE_MIN=15
# Durée de la fenêtre d'absorption (régime fenêtre uniquement ; minutes,
# 5 → 720 ; défaut 120 = 2 h). Après clôture : plus jamais de datasets.
AUTO_APPRENTISSAGE_ABSORPTION_MIN=120
# Intervalle des cycles PENDANT la fenêtre (minutes, 5 → 120 ; défaut 20) —
# plus rapproché que l'ancienne boucle périodique pour maximiser l'absorption.
AUTO_APPRENTISSAGE_ABSORPTION_INTERVALLE_MIN=20
# Délai avant le premier cycle après le boot (secondes, 10 → 600).
AUTO_APPRENTISSAGE_DELAI_S=20
# (Historique) Intervalle de l'ancienne boucle périodique — remplacé par la
# fenêtre d'absorption + AUTO_APPRENTISSAGE_ABSORPTION_INTERVALLE_MIN.
AUTO_APPRENTISSAGE_INTERVALLE_MIN=120
# Plafonds d'ingestion par cycle (Mo, lignes, paires, échantillons) —
# bornés par des valeurs saines côté code (VPS 2 Go).
AUTO_APPRENTISSAGE_MAX_FICHIER_MO=6
AUTO_APPRENTISSAGE_MAX_TOTAL_MO=24
AUTO_APPRENTISSAGE_MAX_LIGNES=1200
AUTO_APPRENTISSAGE_MAX_PAIRES=400
AUTO_APPRENTISSAGE_MAX_ECHANTILLONS=300
AUTO_APPRENTISSAGE_MAX_ECHANTILLONS_CYCLE=240
AUTO_APPRENTISSAGE_MAX_DATASETS=4
