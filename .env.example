# =========================================================
# AGENT SCHEDULER
# =========================================================
# Secret server-only used by the Vercel cron endpoint.
# Generate a long random value and set the same value in Vercel.
CRON_SECRET=

# Signature HMAC-SHA256 des webhooks ENTRANTS /api/webhooks/agent-triggers/<token>.
# En-tete attendu sur le POST : X-Gen3ia-Signature: sha256=<hex> — <hex> =
# HMAC-SHA256 du corps BRUT (octets exacts envoyes), cle = cette variable.
# - Variable VIDE  : comportement historique conserve (token d'URL seul),
#   un warning "signature HMAC non configurée" est logge au premier POST.
# - Variable DEFINIE : la signature devient OBLIGATOIRE (401 sans en-tete
#   ou signature invalide) ; le token d'URL reste requis en plus.
# Generer : openssl rand -hex 32
AGENT_TRIGGER_WEBHOOK_SECRET=

# =========================================================
# ZERO TRUST — IDENTITÉ DE SERVICE INTERNE (Task I)
# =========================================================
# Registre des secrets de signature des appels ENTRE services (crons,
# workers, moteur IA → routes système internes) : lib/security/service-
# identity.ts. Un service signe ses requêtes avec trois en-têtes :
#   X-Gen3ia-Service   : nom logique de l'appelant (clé ci-dessous)
#   X-Gen3ia-Timestamp : epoch secondes (anti-replay, fenêtre ±300 s)
#   X-Gen3ia-Signature : "sha256=" + hex(HMAC-SHA256(secret du service,
#       "service:method:path:timestamp:sha256(corps)"))
# Format de la variable : « nom1:secret1,nom2:secret2 » (un secret DÉDIÉ
# par service, généré via : openssl rand -hex 32).
# Exemple : GEN3IA_SERVICE_TOKENS="cron:<64 hex>,pipeline:<64 hex>,agent-system:<64 hex>"
#
# RÉTROCOMPATIBILITÉ (aucune rupture de service) :
#   - variable VIDE/absente : identité de service désactivée, les routes
#     internes retombent sur leur authentification historique (bearer
#     CRON_SECRET / AGENTS_SYSTEM_SECRET) — un warning est loggé au
#     premier appel pour rappeler d'activer la signature ;
#   - variable DÉFINIE : la signature de service est acceptée EN PLUS du
#     bearer historique sur /api/cron/* et /api/agents/system/activate.
# STRATÉGIE RECOMMANDÉE : définir les tokens au prochain déploiement
# (ajout sans impact), faire signer les appelants (signServiceRequest),
# puis retirer les secrets partagés une fois plus aucun appelant dessus.
GEN3IA_SERVICE_TOKENS=

