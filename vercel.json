{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/agent-schedules",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/cleanup-invitations",
      "schedule": "30 6 * * *"
    }
  ]
}