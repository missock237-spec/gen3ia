{
  "name": "gen3ia-ai-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/version-manifest.mjs init && next build && node scripts/version-manifest.mjs finalize",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:firebase": "npx firebase-tools emulators:exec --config infra/firebase.json --project demo-gen3ia \"vitest run --config vitest.e2e.config.mts\"",
    "format": "prettier --write .",
    "live:gateway": "NODE_OPTIONS='--conditions react-server' tsx lib/live/gateway-server.ts",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "npx firebase-tools emulators:exec --config infra/firebase.json --project demo-gen3ia \"vitest run --config vitest.e2e.config.mts\"",
    "check:bundle": "node scripts/check_bundle_budget.mjs",
    "setup:hooks": "cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "check:a11y": "node scripts/a11y_prod.mjs",
    "sdk:build": "node services/sdk/build.mjs",
    "sdk:pack": "npm pack ./services/sdk --pack-destination public/sdk",
    "sdk:test": "vitest run services/sdk/test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1153.0",
    "@composio/core": "0.25.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@sentry/nextjs": "^10.75.3",
    "@smithy/node-http-handler": "4.12.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "archiver": "^8.0.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "kokoro-js": "^1.2.1",
    "next": "15.5.28",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "ws": "8.22.0",
    "yauzl": "^3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@fastify/rate-limit": "^11.2.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "16.4.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.26",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "2.0.4",
    "postcss": "^8.5.23",
    "undici": "7.30.1",
    "dompurify": "^3.4.16",
    "@grpc/grpc-js": "^1.14.5"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true
  }
}
