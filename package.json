{
  "name": "gen3ia-ai-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:firebase": "npx firebase-tools emulators:exec --project demo-gen3ia \"vitest run --config vitest.e2e.config.mts\"",
    "format": "prettier --write .",
    "live:gateway": "tsx lib/live/gateway-server.ts",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "npx firebase-tools emulators:exec --project demo-gen3ia \"vitest run --config vitest.e2e.config.mts\"",
    "check:bundle": "node scripts/check_bundle_budget.mjs",
    "setup:hooks": "cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "check:a11y": "node scripts/a11y_prod.mjs",
    "sdk:build": "node sdk/build.mjs",
    "sdk:pack": "npm pack ./sdk --pack-destination public/sdk",
    "sdk:test": "vitest run sdk/test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/s3-request-presigner": "3.1133.0",
    "@smithy/node-http-handler": "4.12.1",
    "@composio/core": "0.17.0",
    "@huggingface/inference": "4.13.28",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@sentry/nextjs": "^10.75.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "archiver": "^7.0.1",
    "docx": "^9.0.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "next": "15.5.26",
    "openai": "6.49.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "ws": "8.21.3",
    "yauzl": "^3.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "15.5.26",
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.26",
    "playwright": "^1.63.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "2.0.4",
    "postcss": "^8.5.23",
    "undici": "7.30.0",
    "dompurify": "^3.4.16",
    "@grpc/grpc-js": "^1.14.5"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true
  }
}